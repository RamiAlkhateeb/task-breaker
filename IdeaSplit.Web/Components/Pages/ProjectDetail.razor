@page "/project/{ProjectId:guid}"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@inject IProjectStore ProjectStore
@inject NavigationManager Nav
@inject IdeaSplit.Web.Services.UndoService Undo
@inject IJSRuntime JS
@inject IRoutineStore Routines
@inject ToastService Toasts
@implements IAsyncDisposable

<div class="page-container" @ref="container">
    @if (project is null)
    {
        <div class="loading-stack" aria-label="@T["loading_project"]" role="status">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <span class="visually-hidden">@T["loading_project"]</span>
        </div>
    }
    else
    {
        <button class="btn btn-link icon-button back-button" title="@T["back"]" aria-label="@T["back"]" @onclick='() => Nav.NavigateTo("/")'><NxtIcon Name="arrow-left" CssClass="flip-rtl" /></button>
        @if (isEditingTitle)
        {
            <div class="project-title-row mb-3">
                <input class="form-control" dir="auto" @bind="editTitleText" @bind:event="oninput" @onkeydown="OnTitleEditKeyDown" />
                <button class="btn btn-outline-primary icon-button" title="@T["save"]" aria-label="@T["save"]" @onclick="SaveTitleEdit"><NxtIcon Name="check" /></button>
            </div>
        }
        else
        {
            <div class="project-title-row">
                <h1 class="mb-0" dir="auto">@T.ProjectTitle(project)</h1>
                <button class="btn btn-link icon-button" title="@T["edit_project_name"]" aria-label="@T["edit_project_name"]" @onclick="StartEditTitle"><NxtIcon Name="pencil" /></button>
            </div>
        }
        <p class="project-meta">
            <button type="button" class="date-edit-button" title="@T["change_date"]" aria-label="@T["change_date"]" aria-expanded="@editingDate" @onclick="() => editingDate = !editingDate">
                @if (project.ScheduleDate is null) { <span class="task-due-badge">@T["set_date"]</span> }
                else { <DueChip Date="project.ScheduleDate" Type="project.ScheduleType" Muted="project.IsArchived" /> }
                <NxtIcon Name="pencil" />
            </button>
            <span class="text-muted">@T.F("done_of", project.DoneCount, project.TotalCount)</span>
        </p>
        @if (editingDate)
        {
            <div class="date-edit-row">
                <label class="visually-hidden" for="project-date">@T["change_date"]</label>
                <input id="project-date" type="date" class="form-control" value="@project.ScheduleDate?.ToString("yyyy-MM-dd")" @onchange="ChangeDateAsync" />
                <button type="button" class="quick-date-chip" @onclick="() => SetDateAsync(DateTime.Today)">@T["today"]</button>
                <button type="button" class="quick-date-chip" @onclick="() => SetDateAsync(DateTime.Today.AddDays(1))">@T["tomorrow"]</button>
            </div>
        }
        @if (!string.IsNullOrWhiteSpace(UsedModel))
        {
            <p class="form-hint">@T.F("generated_with", UsedModel)</p>
        }
        <div class="progress-summary"><span>@project.ProgressPercent.ToString("F1")%</span></div>
        <div class="progress task-progress mb-3">
            <div class="progress-bar" style="width:@(project.ProgressPercent)%"></div>
        </div>

        var topLevel = project.Tasks.Where(x => x.ParentTaskId is null).ToList();
        var open = topLevel.Where(x => !x.IsDone).OrderBy(x => x.SortOrder).ToList();
        var done = topLevel.Where(x => x.IsDone).OrderBy(x => x.SortOrder).ToList();

        @if (open.Count == 0 && done.Count > 0)
        {
            <p class="all-done">@T["all_done"]</p>
        }

        <div class="open-tasks" @ref="openList">
            @foreach (var t in open)
            {
                @TaskGroup(t)
            }
        </div>

        @if (done.Count > 0)
        {
            <button type="button" class="completed-toggle" @onclick="() => showCompleted = !showCompleted"><NxtIcon Name="@(showCompleted ? "chevron-down" : "chevron-right")" CssClass="flip-rtl" /> @T.F("completed", done.Count)</button>
            @if (showCompleted)
            {
                @foreach (var t in done)
                {
                    @TaskGroup(t)
                }
            }
        }

        <div class="add-task-row">
            <NxtIcon Name="plus" CssClass="add-task-glyph" />
            <input class="add-task-input" dir="auto" placeholder="@T["add_task_placeholder"]" @bind="newTaskText" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await AddTask(); })" />
            @if (!string.IsNullOrWhiteSpace(newTaskText))
            {
                <button class="btn btn-primary icon-button" title="@T["add"]" aria-label="@T["add"]" @onclick="AddTask"><NxtIcon Name="arrow-up" /></button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Guid ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "model")] public string? UsedModel { get; set; }


    /// <summary>One top-level task with its sub-tasks, menus and editors.</summary>
    private RenderFragment TaskGroup(TaskItem t) => @<div class="task-group" @key="t" data-task-id="@t.Id">
            <div class="swipe-row" data-swipe-id="@(editingId == t.Id ? null : t.Id.ToString())" data-swipe-right=""
                 data-swipe-left="@(project!.ScheduleType == TaskScheduleType.DayWeek && !t.IsDone ? "" : null)"
                 data-label-right="@(t.IsDone ? T["swipe_reopen"] : T["swipe_done"])" data-label-left="@T["swipe_next_day"]">
            <div class="task-row swipe-surface">
                @if (!t.IsDone) { <span class="drag-handle" title="@T["drag_to_reorder"]" aria-hidden="true"><NxtIcon Name="grip-vertical" /></span> }
                <input type="checkbox" checked="@t.IsDone" @onchange="() => ToggleTask(t)" aria-label="@T["mark_done"]" />
                @if (editingId == t.Id)
                {
                    <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                           @onkeydown="@(e => OnEditKeyDown(e, t))" />
                    <button class="btn btn-outline-primary icon-button" title="@T["save"]" aria-label="@T["save"]" @onclick="() => SaveEdit(t)"><NxtIcon Name="check" /></button>
                }
                else
                {
                    <div class="task-main">
                        <span class="task-title @(t.IsDone ? "task-complete" : "") @(ContainsArabic(t.Title) ? "arabic-text" : "")">@t.Title@if (RoutineOf(t) is not null) {<NxtIcon Name="repeat" CssClass="repeat-mark" />}</span>
                        @if (!string.IsNullOrWhiteSpace(t.ProjectName))
                        {
                            <span class="task-project">@t.ProjectName</span>
                        }
                    </div>
                    <button class="btn btn-link icon-button task-menu-btn" title="@T["edit"]" aria-label="@T["edit"]" @onclick="() => StartEdit(t)"><NxtIcon Name="pencil" /></button>
                    <div class="task-menu-wrap">
                        <button class="btn btn-link icon-button task-menu-btn" title="@T["more_options"]" aria-label="@T["more_options"]" aria-haspopup="menu" aria-expanded="@(menuFor == t.Id)" @onclick="() => ToggleMenu(t)"><NxtIcon Name="more-vertical" /></button>
                        @if (menuFor == t.Id)
                        {
                            <div class="menu-backdrop" @onclick="CloseMenu"></div>
                            <div class="task-menu" role="menu">
                                @if (project!.ScheduleType == TaskScheduleType.DayWeek)
                                {
                                    @if (!t.IsDone)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => MoveToNextDay(t)"><NxtIcon Name="arrow-right-circle" CssClass="flip-rtl" /> @T["move_next_day"]</button>
                                    }
                                    <button type="button" role="menuitem" @onclick="() => DuplicateToNextDay(t)"><NxtIcon Name="copy" /> @T["duplicate_next_day"]</button>
                                    @if (RoutineOf(t) is { } routine)
                                    {
                                        <button type="button" role="menuitem" @onclick="() => StopRepeatingAsync(routine)"><NxtIcon Name="repeat" /> @T["stop_repeating"]</button>
                                    }
                                    else
                                    {
                                        <button type="button" role="menuitem" @onclick="() => { CloseMenu(); repeatingFor = t.Id; }"><NxtIcon Name="repeat" /> @T["repeat"]</button>
                                    }
                                }
                                <button type="button" role="menuitem" @onclick="() => { CloseMenu(); ToggleAddSubtask(t); }"><NxtIcon Name="plus" /> @T["add_subtask"]</button>
                                <button type="button" role="menuitem" class="is-danger" @onclick="async () => { CloseMenu(); await DeleteTask(t); }"><NxtIcon Name="trash" /> @T["delete"]</button>
                            </div>
                        }
                    </div>
                }
            </div>
            </div>

            @foreach (var sub in project!.Tasks.Where(c => c.ParentTaskId == t.Id).OrderBy(c => c.IsDone).ThenBy(c => c.SortOrder))
            {
                <div class="task-row subtask-row" @key="sub">
                    <input type="checkbox" checked="@sub.IsDone" @onchange="() => ToggleTask(sub)" aria-label="@T["mark_done"]" />
                    @if (editingId == sub.Id)
                    {
                        <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                               @onkeydown="@(e => OnEditKeyDown(e, sub))" />
                        <button class="btn btn-outline-primary icon-button" title="@T["save"]" aria-label="@T["save"]" @onclick="() => SaveEdit(sub)"><NxtIcon Name="check" /></button>
                    }
                    else
                    {
                        <span class="task-title @(sub.IsDone ? "task-complete" : "") @(ContainsArabic(sub.Title) ? "arabic-text" : "")">@sub.Title</span>
                        <button class="btn btn-link icon-button task-menu-btn" title="@T["edit"]" aria-label="@T["edit"]" @onclick="() => StartEdit(sub)"><NxtIcon Name="pencil" /></button>
                        <div class="task-menu-wrap">
                            <button class="btn btn-link icon-button task-menu-btn" title="@T["more_options"]" aria-label="@T["more_options"]" aria-haspopup="menu" aria-expanded="@(menuFor == sub.Id)" @onclick="() => ToggleMenu(sub)"><NxtIcon Name="more-vertical" /></button>
                            @if (menuFor == sub.Id)
                            {
                                <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                <div class="task-menu" role="menu">
                                    <button type="button" role="menuitem" class="is-danger" @onclick="async () => { CloseMenu(); await DeleteTask(sub); }"><NxtIcon Name="trash" /> @T["delete"]</button>
                                </div>
                            }
                        </div>
                    }
                </div>
            }

            @if (repeatingFor == t.Id)
            {
                <RepeatEditor Days="@(1 << (int)(project!.ScheduleDate ?? DateTime.Today).DayOfWeek)" OnSave="days => RepeatAsync(t, days)" OnCancel="() => repeatingFor = null" />
            }

            @if (addingSubtaskFor == t.Id)
            {
                <div class="add-subtask-row">
                    <input class="form-control form-control-sm" dir="auto" placeholder="@T["add_subtask_placeholder"]" @bind="newSubtaskText" @bind:event="oninput"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await AddSubtask(t); })" />
                    <button class="btn btn-outline-primary icon-button" title="@T["add_subtask"]" aria-label="@T["add_subtask"]" @onclick="() => AddSubtask(t)"><NxtIcon Name="plus" /></button>
                </div>
            }
        </div>;

    private Project? project;
    private ElementReference container;
    private ElementReference openList;
    private bool sortAttached;
    private bool editingDate;
    private DotNetObjectReference<ProjectDetail>? self;
    private Guid? editingId;
    private string editText = "";
    private bool isEditingTitle;
    private string editTitleText = "";
    private bool showCompleted;
    private Guid? menuFor;
    private string newTaskText = "";
    private Guid? addingSubtaskFor;
    private string newSubtaskText = "";

    private static bool ContainsArabic(string text) => text.Any(character =>
        (character >= '؀' && character <= 'ۿ') ||
        (character >= 'ݐ' && character <= 'ݿ') ||
        (character >= 'ࢠ' && character <= 'ࣿ') ||
        (character >= 'ﭐ' && character <= '﷿') ||
        (character >= 'ﹰ' && character <= '﻿'));

    private Guid loadedId;

    // Parameters, not initialisation: navigating from one project to another reuses this page.
    protected override async Task OnParametersSetAsync()
    {
        if (loadedId == ProjectId && project is not null) return;
        loadedId = ProjectId;
        project = null;
        editingDate = false;
        await Load();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            self = DotNetObjectReference.Create(this);
            await JS.InvokeVoidAsync("nxtTaskSwipe.attach", container, self);
        }
        // The list only exists once the project has loaded.
        if (!sortAttached && project is not null && self is not null)
        {
            sortAttached = true;
            await JS.InvokeVoidAsync("nxtTaskSort.attach", openList, self);
        }
    }

    [JSInvokable]
    public async Task OnReorder(string id, int newIndex)
    {
        if (project is null) return;
        var open = project.Tasks.Where(x => x.ParentTaskId is null && !x.IsDone).OrderBy(x => x.SortOrder).ToList();
        var moved = open.FirstOrDefault(x => x.Id.ToString() == id);
        if (moved is null) return;
        open.Remove(moved);
        open.Insert(Math.Clamp(newIndex, 0, open.Count), moved);
        var order = 0;
        foreach (var task in open) task.SortOrder = order++;
        foreach (var task in project.Tasks.Where(x => x.ParentTaskId is null && x.IsDone).OrderBy(x => x.SortOrder)) task.SortOrder = order++;
        await ProjectStore.SaveProjectAsync(project);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnSwipe(string id, string direction)
    {
        var task = project?.Tasks.FirstOrDefault(candidate => candidate.Id.ToString() == id);
        if (task is null) return;
        if (direction == "right") await ToggleTask(task);
        else if (!task.IsDone) await MoveToNextDay(task);
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("nxtTaskSwipe.detach", container); }
        catch (JSDisconnectedException) { }
        self?.Dispose();
    }

    private List<Routine> routines = [];
    private Guid? repeatingFor;

    /// <summary>The routine this task was added by (or made into), if any.</summary>
    private Routine? RoutineOf(TaskItem task) =>
        project?.ScheduleType == TaskScheduleType.DayWeek && project.ScheduleDate is { } date
            ? routines.FirstOrDefault(routine => routine.TaskIdFor(date) == task.Id)
            : null;

    private async Task RepeatAsync(TaskItem task, int days)
    {
        repeatingFor = null;
        if (project is null) return;
        await Routines.RepeatTaskAsync(project.Id, task.Id, days);
        Toasts.Show(T.F("repeat_saved", RepeatEditor.Summary(days, T)));
        await Load();
    }

    private async Task StopRepeatingAsync(Routine routine)
    {
        CloseMenu();
        await Routines.DeleteRoutineAsync(routine.Id);
        await Load();
        Toasts.ShowWithAction(T.F("routine_stopped", routine.Title), T["undo"], async () =>
        {
            await Routines.SaveRoutineAsync(routine);
            await Load();
            await InvokeAsync(StateHasChanged);
        });
    }

    private async Task Load()
    {
        routines = await Routines.GetRoutinesAsync();
        project = await ProjectStore.GetProjectAsync(ProjectId);
    }

    private async Task ToggleTask(TaskItem t)
    {
        if (project is null) return;
        var checkpoint = await Undo.CheckpointAsync();
        t.IsDone = !t.IsDone;
        project.UpdateArchivedState();
        await ProjectStore.SaveProjectAsync(project);
        if (t.IsDone)
        {
            await JS.InvokeVoidAsync("nxtTaskSwipe.tick");
            await checkpoint.OfferAsync(T.F("task_done_toast", t.Title));
        }
        await Load();
    }

    private void ToggleMenu(TaskItem t) => menuFor = menuFor == t.Id ? null : t.Id;

    private void CloseMenu() => menuFor = null;

    private async Task DuplicateToNextDay(TaskItem t)
    {
        menuFor = null;
        if (project is null) return;
        var target = await ProjectStore.GetOrCreateDayProjectAsync((project.ScheduleDate ?? DateTime.Today).Date.AddDays(1));

        var copy = new TaskItem
        {
            Title = t.Title,
            ProjectName = t.ProjectName,
            SortOrder = target.Tasks.Count(x => x.ParentTaskId is null)
        };
        target.Tasks.Add(copy);
        target.IsArchived = false;
        await ProjectStore.SaveProjectAsync(target);

        var subtasks = project.Tasks.Where(x => x.ParentTaskId == t.Id).OrderBy(x => x.SortOrder).ToList();
        if (subtasks.Count > 0)
        {
            foreach (var (sub, index) in subtasks.Select((sub, index) => (sub, index)))
                target.Tasks.Add(new TaskItem { ParentTaskId = copy.Id, Title = sub.Title, SortOrder = index });
            await ProjectStore.SaveProjectAsync(target);
        }
    }

    private async Task MoveToNextDay(TaskItem t)
    {
        menuFor = null;
        if (project is null) return;
        var checkpoint = await Undo.CheckpointAsync();
        await ProjectStore.MoveTasksToDayAsync(project, [t], (project.ScheduleDate ?? DateTime.Today).Date.AddDays(1));
        await checkpoint.OfferAsync(T["moved_to_next_day"]);
        await Load();
    }

    private Task ChangeDateAsync(ChangeEventArgs e) =>
        DateTime.TryParseExact(e.Value?.ToString(), "yyyy-MM-dd", System.Globalization.CultureInfo.InvariantCulture,
            System.Globalization.DateTimeStyles.None, out var date) ? SetDateAsync(date) : Task.CompletedTask;

    /// <summary>
    /// Reschedules the project. A day moved onto a date that already has a day project joins it, so each date
    /// still shows up once.
    /// </summary>
    private async Task SetDateAsync(DateTime date)
    {
        if (project is null || project.ScheduleDate?.Date == date.Date) { editingDate = false; return; }
        var checkpoint = await Undo.CheckpointAsync();
        editingDate = false;

        if (project.ScheduleType == TaskScheduleType.DayWeek)
        {
            var existing = (await ProjectStore.GetProjectsAsync()).FirstOrDefault(other => other.Id != project.Id
                && other.ScheduleType == TaskScheduleType.DayWeek && other.ScheduleDate?.Date == date.Date);
            if (existing is not null)
            {
                var target = await ProjectStore.MoveTasksToDayAsync(project, project.Tasks.Where(x => x.ParentTaskId is null).ToList(), date);
                target.UpdateArchivedState();
                await ProjectStore.SaveProjectAsync(target);
                await ProjectStore.DeleteProjectAsync(project.Id);
                await checkpoint.OfferAsync(T.F("moved_to_day", T.DayName(date)));
                Nav.NavigateTo($"project/{target.Id}", replace: true);
                return;
            }
            // Keep generated day names in step with the date; a name the user typed stays.
            if (project.ScheduleDate is { } old && project.Title == old.ToString("dddd, MMM d", System.Globalization.CultureInfo.InvariantCulture))
                project.Title = date.ToString("dddd, MMM d", System.Globalization.CultureInfo.InvariantCulture);
        }

        project.ScheduleDate = date.Date;
        await ProjectStore.SaveProjectAsync(project);
        await checkpoint.OfferAsync(T["date_changed"]);
        await Load();
    }

    private void StartEdit(TaskItem t)
    {
        editingId = t.Id;
        editText = t.Title;
    }

    private async Task SaveEdit(TaskItem t)
    {
        t.Title = editText;
        if (project is not null) await ProjectStore.SaveProjectAsync(project);
        editingId = null;
    }

    private async Task OnEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TaskItem t)
    {
        if (e.Key == "Enter") await SaveEdit(t);
    }

    private void StartEditTitle()
    {
        editTitleText = project?.Title ?? "";
        isEditingTitle = true;
    }

    private async Task SaveTitleEdit()
    {
        if (project is null || string.IsNullOrWhiteSpace(editTitleText))
        {
            isEditingTitle = false;
            return;
        }
        project.Title = editTitleText.Trim();
        await ProjectStore.SaveProjectAsync(project);
        isEditingTitle = false;
    }

    private async Task OnTitleEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitleEdit();
    }

    private async Task DeleteTask(TaskItem t)
    {
        if (project is null) return;
        var checkpoint = await Undo.CheckpointAsync();
        project.Tasks.RemoveAll(x => x.Id == t.Id || x.ParentTaskId == t.Id);
        await ProjectStore.SaveProjectAsync(project);
        await checkpoint.OfferAsync(T["task_deleted"]);
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            Title = newTaskText,
            SortOrder = project.Tasks.Count(x => x.ParentTaskId is null)
        });
        await ProjectStore.SaveProjectAsync(project);
        newTaskText = "";
    }

    private void ToggleAddSubtask(TaskItem parent)
    {
        addingSubtaskFor = addingSubtaskFor == parent.Id ? null : parent.Id;
        newSubtaskText = "";
    }

    private async Task AddSubtask(TaskItem parent)
    {
        if (string.IsNullOrWhiteSpace(newSubtaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            ParentTaskId = parent.Id,
            Title = newSubtaskText,
            SortOrder = project.Tasks.Count(c => c.ParentTaskId == parent.Id)
        });
        await ProjectStore.SaveProjectAsync(project);
        newSubtaskText = "";
    }
}
