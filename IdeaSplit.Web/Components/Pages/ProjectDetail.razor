@page "/project/{ProjectId:int}"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@inject IProjectStore ProjectStore
@inject NavigationManager Nav

<div class="page-container">
    @if (project is null)
    {
        <div class="loading-stack" aria-label="Loading project" role="status">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <span class="visually-hidden">Loading project</span>
        </div>
    }
    else
    {
        <button class="btn btn-link icon-button back-button" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/")'><i class="bi bi-arrow-left"></i></button>
        @if (isEditingTitle)
        {
            <div class="project-title-row mb-3">
                <input class="form-control" dir="auto" @bind="editTitleText" @bind:event="oninput" @onkeydown="OnTitleEditKeyDown" />
                <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="SaveTitleEdit"><i class="bi bi-check-lg"></i></button>
            </div>
        }
        else
        {
            <div class="project-title-row">
                <h1 class="mb-0">@project.Title</h1>
                <button class="btn btn-link icon-button" title="Edit project name" aria-label="Edit project name" @onclick="StartEditTitle"><i class="bi bi-pencil"></i></button>
            </div>
        }
        <p class="text-muted">
            @project.DoneCount of @project.TotalCount tasks done
            @if (project.ScheduleDate is not null)
            {
                <span class="task-due-badge" title="@(project.ScheduleType == TaskScheduleType.ProjectDeadline ? "Deadline" : "Date")">
                    <i class="bi @(project.ScheduleType == TaskScheduleType.ProjectDeadline ? "bi-flag" : "bi-calendar3")" aria-hidden="true"></i>
                    @project.ScheduleDate.Value.ToString("MMM d")
                </span>
            }
        </p>
        @if (!string.IsNullOrWhiteSpace(UsedModel))
        {
            <p class="form-hint">Tasks generated with @UsedModel.</p>
        }
        <div class="progress-summary"><span>@project.ProgressPercent.ToString("F1")%</span></div>
        <div class="progress task-progress mb-3">
            <div class="progress-bar" style="width:@(project.ProgressPercent)%"></div>
        </div>

        @foreach (var t in project.Tasks.Where(t => t.ParentTaskId is null).OrderBy(t => t.IsDone).ThenBy(t => t.SortOrder))
        {
            <div class="task-row">
                <input type="checkbox" checked="@t.IsDone" @onchange="() => ToggleTask(t)" />
                @if (editingId == t.Id)
                {
                    <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                           @onkeydown="@(e => OnEditKeyDown(e, t))" />
                    <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="() => SaveEdit(t)"><i class="bi bi-check-lg"></i></button>
                }
                else
                {
                    <span class="task-title @(t.IsDone ? "task-complete" : "") @(ContainsArabic(t.Title) ? "arabic-text" : "")">@t.Title</span>
                    <button class="btn btn-link icon-button" title="Add subtask" aria-label="Add subtask" @onclick="() => ToggleAddSubtask(t)"><i class="bi bi-plus-lg"></i></button>
                    <button class="btn btn-link icon-button" title="Edit" aria-label="Edit" @onclick="() => StartEdit(t)"><i class="bi bi-pencil"></i></button>
                    <button class="btn btn-link text-danger icon-button" title="Delete" aria-label="Delete" @onclick="() => DeleteTask(t)"><i class="bi bi-trash"></i></button>
                }
            </div>

            @foreach (var sub in project.Tasks.Where(c => c.ParentTaskId == t.Id).OrderBy(c => c.IsDone).ThenBy(c => c.SortOrder))
            {
                <div class="task-row subtask-row">
                    <input type="checkbox" checked="@sub.IsDone" @onchange="() => ToggleTask(sub)" />
                    @if (editingId == sub.Id)
                    {
                        <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                               @onkeydown="@(e => OnEditKeyDown(e, sub))" />
                        <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="() => SaveEdit(sub)"><i class="bi bi-check-lg"></i></button>
                    }
                    else
                    {
                        <span class="task-title @(sub.IsDone ? "task-complete" : "") @(ContainsArabic(sub.Title) ? "arabic-text" : "")">@sub.Title</span>
                        <button class="btn btn-link icon-button" title="Edit" aria-label="Edit" @onclick="() => StartEdit(sub)"><i class="bi bi-pencil"></i></button>
                        <button class="btn btn-link text-danger icon-button" title="Delete" aria-label="Delete" @onclick="() => DeleteTask(sub)"><i class="bi bi-trash"></i></button>
                    }
                </div>
            }

            @if (addingSubtaskFor == t.Id)
            {
                <div class="add-subtask-row">
                    <input class="form-control form-control-sm" dir="auto" placeholder="Add a subtask" @bind="newSubtaskText" @bind:event="oninput"
                           @onkeydown="@(async e => { if (e.Key == "Enter") await AddSubtask(t); })" />
                    <button class="btn btn-outline-primary icon-button" title="Add subtask" aria-label="Add subtask" @onclick="() => AddSubtask(t)"><i class="bi bi-plus-lg"></i></button>
                </div>
            }
        }

        <div class="add-task-row">
            <input class="form-control" dir="auto" placeholder="Add a task" @bind="newTaskText" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await AddTask(); })" />
            <button class="btn btn-outline-primary icon-button" title="Add" aria-label="Add" @onclick="AddTask"><i class="bi bi-plus-lg"></i></button>
        </div>
    }
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "model")] public string? UsedModel { get; set; }

    private Project? project;
    private int? editingId;
    private string editText = "";
    private bool isEditingTitle;
    private string editTitleText = "";
    private string newTaskText = "";
    private int? addingSubtaskFor;
    private string newSubtaskText = "";

    private static bool ContainsArabic(string text) => text.Any(character =>
        (character >= '؀' && character <= 'ۿ') ||
        (character >= 'ݐ' && character <= 'ݿ') ||
        (character >= 'ࢠ' && character <= 'ࣿ') ||
        (character >= 'ﭐ' && character <= '﷿') ||
        (character >= 'ﹰ' && character <= '﻿'));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        project = await ProjectStore.GetProjectAsync(ProjectId);
    }

    private async Task ToggleTask(TaskItem t)
    {
        t.IsDone = !t.IsDone;
        if (project is not null)
        {
            project.IsArchived = project.TotalCount > 0 && project.DoneCount == project.TotalCount;
            await ProjectStore.SaveProjectAsync(project);
        }
    }

    private void StartEdit(TaskItem t)
    {
        editingId = t.Id;
        editText = t.Title;
    }

    private async Task SaveEdit(TaskItem t)
    {
        t.Title = editText;
        if (project is not null) await ProjectStore.SaveProjectAsync(project);
        editingId = null;
    }

    private async Task OnEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TaskItem t)
    {
        if (e.Key == "Enter") await SaveEdit(t);
    }

    private void StartEditTitle()
    {
        editTitleText = project?.Title ?? "";
        isEditingTitle = true;
    }

    private async Task SaveTitleEdit()
    {
        if (project is null || string.IsNullOrWhiteSpace(editTitleText))
        {
            isEditingTitle = false;
            return;
        }
        project.Title = editTitleText.Trim();
        await ProjectStore.SaveProjectAsync(project);
        isEditingTitle = false;
    }

    private async Task OnTitleEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitleEdit();
    }

    private async Task DeleteTask(TaskItem t)
    {
        project?.Tasks.RemoveAll(x => x.Id == t.Id || x.ParentTaskId == t.Id);
        if (project is not null) await ProjectStore.SaveProjectAsync(project);
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            Title = newTaskText,
            SortOrder = project.Tasks.Count(x => x.ParentTaskId is null)
        });
        await ProjectStore.SaveProjectAsync(project);
        newTaskText = "";
    }

    private void ToggleAddSubtask(TaskItem parent)
    {
        addingSubtaskFor = addingSubtaskFor == parent.Id ? null : parent.Id;
        newSubtaskText = "";
    }

    private async Task AddSubtask(TaskItem parent)
    {
        if (string.IsNullOrWhiteSpace(newSubtaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            ParentTaskId = parent.Id,
            Title = newSubtaskText,
            SortOrder = project.Tasks.Count(c => c.ParentTaskId == parent.Id)
        });
        await ProjectStore.SaveProjectAsync(project);
        newSubtaskText = "";
    }
}
