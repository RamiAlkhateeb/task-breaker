@page "/project/{ProjectId:int}"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@inject IProjectStore ProjectStore
@inject NavigationManager Nav

<div class="page-container">
    @if (project is null)
    {
        <div class="loading-stack" aria-label="Loading project" role="status">
            <div class="skeleton-line skeleton-title"></div>
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
            <span class="visually-hidden">Loading project</span>
        </div>
    }
    else
    {
        <button class="btn btn-link icon-button back-button" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/")'><i class="bi bi-arrow-left"></i></button>
        @if (isEditingTitle)
        {
            <div class="project-title-row mb-3">
                <input class="form-control" dir="auto" @bind="editTitleText" @bind:event="oninput" @onkeydown="OnTitleEditKeyDown" />
                <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="SaveTitleEdit"><i class="bi bi-check-lg"></i></button>
            </div>
        }
        else
        {
            <div class="project-title-row">
                <h1 class="mb-0">@project.Title</h1>
                <button class="btn btn-link icon-button" title="Edit project name" aria-label="Edit project name" @onclick="StartEditTitle"><i class="bi bi-pencil"></i></button>
            </div>
        }
        <p class="project-meta">
            <DueChip Date="project.ScheduleDate" Type="project.ScheduleType" Muted="project.IsArchived" />
            <span class="text-muted">@project.DoneCount of @project.TotalCount tasks done</span>
        </p>
        @if (!string.IsNullOrWhiteSpace(UsedModel))
        {
            <p class="form-hint">Tasks generated with @UsedModel.</p>
        }
        <div class="progress-summary"><span>@project.ProgressPercent.ToString("F1")%</span></div>
        <div class="progress task-progress mb-3">
            <div class="progress-bar" style="width:@(project.ProgressPercent)%"></div>
        </div>

        var topLevel = project.Tasks.Where(x => x.ParentTaskId is null).ToList();
        var open = topLevel.Where(x => !x.IsDone).OrderBy(x => x.SortOrder).ToList();
        var done = topLevel.Where(x => x.IsDone).OrderBy(x => x.SortOrder).ToList();
        var firstDone = done.FirstOrDefault();
        var visible = showCompleted ? open.Concat(done).ToList() : open;

        @if (open.Count == 0 && done.Count > 0)
        {
            <p class="all-done">All tasks done</p>
        }

        @foreach (var t in visible)
        {
            @if (showCompleted && ReferenceEquals(t, firstDone))
            {
                <button type="button" class="completed-toggle" @onclick="() => showCompleted = false"><i class="bi bi-chevron-down" aria-hidden="true"></i> Completed (@done.Count)</button>
            }

            <div class="task-group" @key="t">
                <div class="task-row">
                    <input type="checkbox" checked="@t.IsDone" @onchange="() => ToggleTask(t)" aria-label="Mark done" />
                    @if (editingId == t.Id)
                    {
                        <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                               @onkeydown="@(e => OnEditKeyDown(e, t))" />
                        <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="() => SaveEdit(t)"><i class="bi bi-check-lg"></i></button>
                    }
                    else
                    {
                        <div class="task-main">
                            <span class="task-title @(t.IsDone ? "task-complete" : "") @(ContainsArabic(t.Title) ? "arabic-text" : "")">@t.Title</span>
                            @if (!string.IsNullOrWhiteSpace(t.ProjectName))
                            {
                                <span class="task-project">@t.ProjectName</span>
                            }
                        </div>
                        <div class="task-menu-wrap">
                            <button class="btn btn-link icon-button task-menu-btn" title="More" aria-label="More options" aria-haspopup="menu" aria-expanded="@(menuFor == t.Id)" @onclick="() => ToggleMenu(t)"><i class="bi bi-three-dots-vertical"></i></button>
                            @if (menuFor == t.Id)
                            {
                                <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                <div class="task-menu" role="menu">
                                    @if (project.ScheduleType == TaskScheduleType.DayWeek)
                                    {
                                        @if (!t.IsDone)
                                        {
                                            <button type="button" role="menuitem" @onclick="() => MoveToNextDay(t)"><i class="bi bi-arrow-right-circle" aria-hidden="true"></i> Move to next day</button>
                                        }
                                        <button type="button" role="menuitem" @onclick="() => DuplicateToNextDay(t)"><i class="bi bi-copy" aria-hidden="true"></i> Duplicate to next day</button>
                                    }
                                    <button type="button" role="menuitem" @onclick="() => { CloseMenu(); ToggleAddSubtask(t); }"><i class="bi bi-plus-lg" aria-hidden="true"></i> Add subtask</button>
                                    <button type="button" role="menuitem" @onclick="() => { CloseMenu(); StartEdit(t); }"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                                    <button type="button" role="menuitem" class="is-danger" @onclick="async () => { CloseMenu(); await DeleteTask(t); }"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                                </div>
                            }
                        </div>
                    }
                </div>

                @foreach (var sub in project.Tasks.Where(c => c.ParentTaskId == t.Id).OrderBy(c => c.IsDone).ThenBy(c => c.SortOrder))
                {
                    <div class="task-row subtask-row" @key="sub">
                        <input type="checkbox" checked="@sub.IsDone" @onchange="() => ToggleTask(sub)" aria-label="Mark done" />
                        @if (editingId == sub.Id)
                        {
                            <input class="form-control form-control-sm" dir="auto" @bind="editText" @bind:event="oninput"
                                   @onkeydown="@(e => OnEditKeyDown(e, sub))" />
                            <button class="btn btn-outline-primary icon-button" title="Save" aria-label="Save" @onclick="() => SaveEdit(sub)"><i class="bi bi-check-lg"></i></button>
                        }
                        else
                        {
                            <span class="task-title @(sub.IsDone ? "task-complete" : "") @(ContainsArabic(sub.Title) ? "arabic-text" : "")">@sub.Title</span>
                            <div class="task-menu-wrap">
                                <button class="btn btn-link icon-button task-menu-btn" title="More" aria-label="More options" aria-haspopup="menu" aria-expanded="@(menuFor == sub.Id)" @onclick="() => ToggleMenu(sub)"><i class="bi bi-three-dots-vertical"></i></button>
                                @if (menuFor == sub.Id)
                                {
                                    <div class="menu-backdrop" @onclick="CloseMenu"></div>
                                    <div class="task-menu" role="menu">
                                        <button type="button" role="menuitem" @onclick="() => { CloseMenu(); StartEdit(sub); }"><i class="bi bi-pencil" aria-hidden="true"></i> Edit</button>
                                        <button type="button" role="menuitem" class="is-danger" @onclick="async () => { CloseMenu(); await DeleteTask(sub); }"><i class="bi bi-trash" aria-hidden="true"></i> Delete</button>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                }

                @if (addingSubtaskFor == t.Id)
                {
                    <div class="add-subtask-row">
                        <input class="form-control form-control-sm" dir="auto" placeholder="Add a subtask" @bind="newSubtaskText" @bind:event="oninput"
                               @onkeydown="@(async e => { if (e.Key == "Enter") await AddSubtask(t); })" />
                        <button class="btn btn-outline-primary icon-button" title="Add subtask" aria-label="Add subtask" @onclick="() => AddSubtask(t)"><i class="bi bi-plus-lg"></i></button>
                    </div>
                }
            </div>
        }

        @if (!showCompleted && done.Count > 0)
        {
            <button type="button" class="completed-toggle" @onclick="() => showCompleted = true"><i class="bi bi-chevron-right" aria-hidden="true"></i> Completed (@done.Count)</button>
        }

        <div class="add-task-row">
            <i class="bi bi-plus-lg add-task-glyph" aria-hidden="true"></i>
            <input class="add-task-input" dir="auto" placeholder="Add a task" @bind="newTaskText" @bind:event="oninput"
                   @onkeydown="@(async e => { if (e.Key == "Enter") await AddTask(); })" />
            @if (!string.IsNullOrWhiteSpace(newTaskText))
            {
                <button class="btn btn-primary icon-button" title="Add" aria-label="Add" @onclick="AddTask"><i class="bi bi-arrow-up"></i></button>
            }
        </div>
    }
</div>

@code {
    [Parameter] public int ProjectId { get; set; }
    [SupplyParameterFromQuery(Name = "model")] public string? UsedModel { get; set; }

    private Project? project;
    private int? editingId;
    private string editText = "";
    private bool isEditingTitle;
    private string editTitleText = "";
    private bool showCompleted;
    private int? menuFor;
    private string newTaskText = "";
    private int? addingSubtaskFor;
    private string newSubtaskText = "";

    private static bool ContainsArabic(string text) => text.Any(character =>
        (character >= '؀' && character <= 'ۿ') ||
        (character >= 'ݐ' && character <= 'ݿ') ||
        (character >= 'ࢠ' && character <= 'ࣿ') ||
        (character >= 'ﭐ' && character <= '﷿') ||
        (character >= 'ﹰ' && character <= '﻿'));

    protected override async Task OnInitializedAsync() => await Load();

    private async Task Load()
    {
        project = await ProjectStore.GetProjectAsync(ProjectId);
    }

    private async Task ToggleTask(TaskItem t)
    {
        t.IsDone = !t.IsDone;
        if (project is not null)
        {
            project.IsArchived = project.TotalCount > 0 && project.DoneCount == project.TotalCount;
            await ProjectStore.SaveProjectAsync(project);
            await Load();
        }
    }

    private void ToggleMenu(TaskItem t) => menuFor = menuFor == t.Id ? null : t.Id;

    private void CloseMenu() => menuFor = null;

    private async Task DuplicateToNextDay(TaskItem t)
    {
        menuFor = null;
        if (project is null) return;
        var target = await ProjectStore.GetOrCreateDayProjectAsync((project.ScheduleDate ?? DateTime.Today).Date.AddDays(1));

        var copy = new TaskItem
        {
            Title = t.Title,
            ProjectName = t.ProjectName,
            SortOrder = target.Tasks.Count(x => x.ParentTaskId is null)
        };
        target.Tasks.Add(copy);
        target.IsArchived = false;
        await ProjectStore.SaveProjectAsync(target);

        var subtasks = project.Tasks.Where(x => x.ParentTaskId == t.Id).OrderBy(x => x.SortOrder).ToList();
        if (subtasks.Count > 0)
        {
            foreach (var (sub, index) in subtasks.Select((sub, index) => (sub, index)))
                target.Tasks.Add(new TaskItem { ParentTaskId = copy.Id, Title = sub.Title, SortOrder = index });
            await ProjectStore.SaveProjectAsync(target);
        }
    }

    private async Task MoveToNextDay(TaskItem t)
    {
        menuFor = null;
        if (project is null) return;
        var target = await ProjectStore.GetOrCreateDayProjectAsync((project.ScheduleDate ?? DateTime.Today).Date.AddDays(1));

        var moving = project.Tasks.Where(x => x.Id == t.Id || x.ParentTaskId == t.Id).ToList();
        project.Tasks.RemoveAll(x => x.Id == t.Id || x.ParentTaskId == t.Id);
        t.SortOrder = target.Tasks.Count(x => x.ParentTaskId is null);
        target.Tasks.AddRange(moving);
        target.IsArchived = false;
        await ProjectStore.SaveProjectAsync(target);

        project.IsArchived = project.TotalCount > 0 && project.DoneCount == project.TotalCount;
        await ProjectStore.SaveProjectAsync(project);
        await Load();
    }

    private void StartEdit(TaskItem t)
    {
        editingId = t.Id;
        editText = t.Title;
    }

    private async Task SaveEdit(TaskItem t)
    {
        t.Title = editText;
        if (project is not null) await ProjectStore.SaveProjectAsync(project);
        editingId = null;
    }

    private async Task OnEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e, TaskItem t)
    {
        if (e.Key == "Enter") await SaveEdit(t);
    }

    private void StartEditTitle()
    {
        editTitleText = project?.Title ?? "";
        isEditingTitle = true;
    }

    private async Task SaveTitleEdit()
    {
        if (project is null || string.IsNullOrWhiteSpace(editTitleText))
        {
            isEditingTitle = false;
            return;
        }
        project.Title = editTitleText.Trim();
        await ProjectStore.SaveProjectAsync(project);
        isEditingTitle = false;
    }

    private async Task OnTitleEditKeyDown(Microsoft.AspNetCore.Components.Web.KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await SaveTitleEdit();
    }

    private async Task DeleteTask(TaskItem t)
    {
        project?.Tasks.RemoveAll(x => x.Id == t.Id || x.ParentTaskId == t.Id);
        if (project is not null) await ProjectStore.SaveProjectAsync(project);
    }

    private async Task AddTask()
    {
        if (string.IsNullOrWhiteSpace(newTaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            Title = newTaskText,
            SortOrder = project.Tasks.Count(x => x.ParentTaskId is null)
        });
        await ProjectStore.SaveProjectAsync(project);
        newTaskText = "";
    }

    private void ToggleAddSubtask(TaskItem parent)
    {
        addingSubtaskFor = addingSubtaskFor == parent.Id ? null : parent.Id;
        newSubtaskText = "";
    }

    private async Task AddSubtask(TaskItem parent)
    {
        if (string.IsNullOrWhiteSpace(newSubtaskText) || project is null) return;
        project.Tasks.Add(new TaskItem
        {
            ProjectId = project.Id,
            ParentTaskId = parent.Id,
            Title = newSubtaskText,
            SortOrder = project.Tasks.Count(c => c.ParentTaskId == parent.Id)
        });
        await ProjectStore.SaveProjectAsync(project);
        newSubtaskText = "";
    }
}
