@page "/"
@using IdeaSplit.Shared.Data
@inject IProjectStore ProjectStore
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>IdeaSplit</PageTitle>

<div class="page-container">
    <div class="page-header">
        <h1>Your projects</h1>
        <div class="header-actions">
            <button class="btn btn-outline-secondary icon-button" title="Settings" aria-label="Settings" @onclick='() => Nav.NavigateTo("/settings")'><i class="bi bi-gear"></i></button>
        </div>
    </div>

    @if (projects is null)
    {
        <div class="loading-stack" aria-label="Loading projects" role="status">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <span class="visually-hidden">Loading projects</span>
        </div>
    }
    else if (projects.Count == 0)
    {
        <div class="empty-state">
            <svg class="empty-state-art" viewBox="0 0 200 160" role="img" aria-label="Lightbulb and empty checklist illustration">
                <path d="M55 22c-19 0-34 15-34 34 0 13 7 24 17 30v13h34V86c10-6 17-17 17-30 0-19-15-34-34-34Z" fill="currentColor" opacity=".18" />
                <path d="M55 31c-14 0-25 11-25 25 0 11 6 19 15 23v12h20V79c9-4 15-12 15-23 0-14-11-25-25-25Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
                <path d="M45 103h20m-17 10h14" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
                <rect x="102" y="32" width="72" height="96" rx="10" fill="currentColor" opacity=".1" />
                <rect x="102" y="32" width="72" height="96" rx="10" fill="none" stroke="currentColor" stroke-width="5" />
                <path d="m115 60 6 6 11-13m-17 31 6 6 11-13m16-19h22m-22 24h22m-22 24h16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h2>No projects yet</h2>
            <p>Tap + to turn an idea into one.</p>
        </div>
    }
    else
    {
        @foreach (var p in projects)
        {
            <div class="card project-card" style="@CardAccent(p)" @onclick='() => Nav.NavigateTo($"/project/{p.Id}")'>
                <div class="card-body">
                    <div class="project-title-row">
                        <h5 class="card-title mb-1">@p.Title</h5>
                        <div class="project-card-actions">
                            @if (p.IsBook)
                            {
                                <span class="book-badge" title="Reading project"><i class="bi bi-book" aria-hidden="true"></i><span>Book</span></span>
                            }
                            <button class="btn btn-link icon-button card-action" title="@(p.IsPinned ? "Unpin project" : "Pin project")" aria-label="@(p.IsPinned ? "Unpin project" : "Pin project")" @onclick="() => TogglePin(p.Id)" @onclick:stopPropagation="true"><i class="bi @(p.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")"></i></button>
                            <button class="btn btn-link icon-button card-action delete-project-button" title="Delete project" aria-label="Delete project" @onclick="() => ConfirmDelete(p.Id)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                    <p class="text-muted mb-2">@p.DoneCount of @p.TotalCount tasks done</p>
                    <div class="progress-summary"><span>@p.ProgressPercent.ToString("F1")%</span></div>
                    <div class="progress task-progress">
                        <div class="progress-bar" style="width:@(p.ProgressPercent)%"></div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<button class="btn btn-primary floating-action-button" title="New project" aria-label="New project" @onclick='() => Nav.NavigateTo("/new")'><i class="bi bi-plus-lg"></i></button>

@code {
    private List<IdeaSplit.Shared.Models.Project>? projects;

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects() =>
        projects = (await ProjectStore.GetProjectsAsync())
            .OrderByDescending(project => project.IsPinned)
            .ThenByDescending(project => project.CreatedAt)
            .ToList();

    private async Task TogglePin(int projectId)
    {
        await ProjectStore.TogglePinAsync(projectId);
        await LoadProjects();
    }

    private async Task ConfirmDelete(int projectId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Delete this project and all of its tasks?"))
        {
            await ProjectStore.DeleteProjectAsync(projectId);
            await LoadProjects();
        }
    }

    private static string CardAccent(IdeaSplit.Shared.Models.Project project)
    {
        var color = project.DoneCount == 0 ? "#ff7a73"
            : project.DoneCount == project.TotalCount ? "#42c78a"
            : "#f5b942";
        return $"--card-accent:{color};";
    }
}
