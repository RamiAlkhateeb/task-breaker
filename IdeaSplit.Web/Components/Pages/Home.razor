@page "/"
@using IdeaSplit.Shared.Data
@inject IProjectStore ProjectStore
@inject NavigationManager Nav
@inject IJSRuntime JS

<PageTitle>NxtTask</PageTitle>

<div class="page-container has-composer">
    <div class="page-header">
        <div><h1>NxtTask</h1>@if (projects is { Count: > 0 }) {<p class="page-subtitle">@projects.Count open @(projects.Count == 1 ? "project" : "projects")</p>}</div>
        <div class="header-actions">
            <NxtIconButton Label="Assistant" Href="ai" Accent="true">
                <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l1.9 5.1L19 10l-5.1 1.9L12 17l-1.9-5.1L5 10l5.1-1.9z"/></svg>
            </NxtIconButton>
            <NxtIconButton Label="Archive" Href="archive">
                <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="5" rx="1.5"/><path d="M5 9v9a2 2 0 0 0 2 2h10a2 2 0 0 0 2-2V9"/><path d="M10 13h4"/></svg>
            </NxtIconButton>
            <NxtIconButton Label="Settings" Href="settings">
                <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.7 1.7 0 0 0 .3 1.8l.1.1a2 2 0 1 1-2.8 2.8l-.1-.1a1.7 1.7 0 0 0-1.8-.3 1.7 1.7 0 0 0-1 1.5V21a2 2 0 1 1-4 0v-.1a1.7 1.7 0 0 0-1.1-1.5 1.7 1.7 0 0 0-1.8.3l-.1.1a2 2 0 1 1-2.8-2.8l.1-.1a1.7 1.7 0 0 0 .3-1.8 1.7 1.7 0 0 0-1.5-1H3a2 2 0 1 1 0-4h.1a1.7 1.7 0 0 0 1.5-1.1 1.7 1.7 0 0 0-.3-1.8l-.1-.1a2 2 0 1 1 2.8-2.8l.1.1a1.7 1.7 0 0 0 1.8.3H9a1.7 1.7 0 0 0 1-1.5V3a2 2 0 1 1 4 0v.1a1.7 1.7 0 0 0 1 1.5 1.7 1.7 0 0 0 1.8-.3l.1-.1a2 2 0 1 1 2.8 2.8l-.1.1a1.7 1.7 0 0 0-.3 1.8V9a1.7 1.7 0 0 0 1.5 1H21a2 2 0 1 1 0 4h-.1a1.7 1.7 0 0 0-1.5 1z"/></svg>
            </NxtIconButton>
        </div>
    </div>

    @if (projects is { Count: > 0 })
    {
        <div class="search-box">
            <i class="bi bi-search" aria-hidden="true"></i>
            <input type="search" class="search-input" dir="auto" placeholder="Search days and tasks" aria-label="Search days and tasks"
                   @bind="query" @bind:event="oninput" />
            @if (query.Length > 0)
            {
                <button type="button" class="search-clear" title="Clear search" aria-label="Clear search" @onclick='() => query = ""'><i class="bi bi-x-lg"></i></button>
            }
        </div>
    }

    @if (projects is null)
    {
        <div class="loading-stack" aria-label="Loading projects" role="status">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <span class="visually-hidden">Loading projects</span>
        </div>
    }
    else if (projects.Count == 0)
    {
        <div class="empty-state">
            <svg class="empty-state-art" viewBox="0 0 200 160" role="img" aria-label="Lightbulb and empty checklist illustration">
                <path d="M55 22c-19 0-34 15-34 34 0 13 7 24 17 30v13h34V86c10-6 17-17 17-30 0-19-15-34-34-34Z" fill="currentColor" opacity=".18" />
                <path d="M55 31c-14 0-25 11-25 25 0 11 6 19 15 23v12h20V79c9-4 15-12 15-23 0-14-11-25-25-25Z" fill="none" stroke="currentColor" stroke-width="5" stroke-linejoin="round" />
                <path d="M45 103h20m-17 10h14" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" />
                <rect x="102" y="32" width="72" height="96" rx="10" fill="currentColor" opacity=".1" />
                <rect x="102" y="32" width="72" height="96" rx="10" fill="none" stroke="currentColor" stroke-width="5" />
                <path d="m115 60 6 6 11-13m-17 31 6 6 11-13m16-19h22m-22 24h22m-22 24h16" fill="none" stroke="currentColor" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
            <h2>No projects yet</h2>
            <p>Describe a plan in the box below and it gets split into a checklist for you.</p>
        </div>
    }
    else if (Filtered.Count == 0)
    {
        <p class="no-results">No matches for “@query.Trim()”.</p>
    }
    else
    {
        @foreach (var p in Filtered)
        {
            <div class="card project-card" style="@CardAccent(p)" @onclick='() => Nav.NavigateTo($"/project/{p.Id}")'>
                <div class="card-body">
                    <h5 class="card-title">@p.Title</h5>
                    <p class="project-meta">
                        <DueChip Date="p.ScheduleDate" Type="p.ScheduleType" />
                        <span class="text-muted">@p.DoneCount/@p.TotalCount tasks</span>
                    </p>
                    <div class="progress task-progress">
                        <div class="progress-bar" style="width:@(p.ProgressPercent)%"></div>
                    </div>
                    @if (HasQuery)
                    {
                        var hits = TaskHits(p);
                        @if (hits.Count > 0)
                        {
                            <ul class="search-hits">
                                @foreach (var hit in hits)
                                {
                                    <li>@hit.Title@if (!string.IsNullOrWhiteSpace(hit.ProjectName)) {<span class="search-hit-project">@hit.ProjectName</span>}</li>
                                }
                            </ul>
                        }
                    }
                    <div class="project-card-footer">
                        <div class="project-card-actions">
                            <button class="btn btn-link icon-button card-action" title="@(p.IsPinned ? "Unpin project" : "Pin project")" aria-label="@(p.IsPinned ? "Unpin project" : "Pin project")" @onclick="() => TogglePin(p.Id)" @onclick:stopPropagation="true"><i class="bi @(p.IsPinned ? "bi-pin-angle-fill" : "bi-pin-angle")"></i></button>
                            <button class="btn btn-link icon-button card-action delete-project-button" title="Delete project" aria-label="Delete project" @onclick="() => ConfirmDelete(p.Id)" @onclick:stopPropagation="true"><i class="bi bi-trash"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

<PlanComposer OnCreated="LoadProjects" />

@code {
    private List<IdeaSplit.Shared.Models.Project>? projects;
    private string query = "";

    private bool HasQuery => !string.IsNullOrWhiteSpace(query);

    private List<IdeaSplit.Shared.Models.Project> Filtered =>
        projects is null || !HasQuery
            ? projects ?? []
            : projects.Where(project => Matches(project.Title) || TaskHits(project).Count > 0).ToList();

    private bool Matches(string? value) =>
        value is not null && value.Contains(query.Trim(), StringComparison.OrdinalIgnoreCase);

    private List<IdeaSplit.Shared.Models.TaskItem> TaskHits(IdeaSplit.Shared.Models.Project project) =>
        project.Tasks.Where(task => Matches(task.Title) || Matches(task.ProjectName)).Take(3).ToList();

    protected override async Task OnInitializedAsync()
    {
        await LoadProjects();
    }

    private async Task LoadProjects() =>
        projects = (await ProjectStore.GetProjectsAsync())
            .Where(project => !project.IsArchived)
            .OrderByDescending(project => project.IsPinned)
            .ThenBy(project => project.ScheduleDate ?? DateTime.MaxValue)
            .ThenByDescending(project => project.CreatedAt)
            .ToList();

    private async Task TogglePin(int projectId)
    {
        await ProjectStore.TogglePinAsync(projectId);
        await LoadProjects();
    }

    private async Task ConfirmDelete(int projectId)
    {
        if (await JS.InvokeAsync<bool>("confirm", "Delete this project and all of its tasks?"))
        {
            await ProjectStore.DeleteProjectAsync(projectId);
            await LoadProjects();
        }
    }

    private static string CardAccent(IdeaSplit.Shared.Models.Project project)
    {
        var color = project.DoneCount == 0 ? "#ff7a73"
            : project.DoneCount == project.TotalCount ? "#42c78a"
            : "#f5b942";
        return $"--card-accent:{color};";
    }
}
