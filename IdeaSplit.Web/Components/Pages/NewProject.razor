@page "/new"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@inject IProjectStore ProjectStore
@inject GeminiService Gemini
@inject NavigationManager Nav

<div class="page-container">
    <h1>New project</h1>
    @if (projectCreated)
    {
        <div class="alert alert-success">Your project is ready with @createdTaskCount tasks. You can check it out on the home page.</div>
        <button class="btn btn-primary action-button" @onclick='() => Nav.NavigateTo("/")'>OK</button>
    }
    else
    {
        <p class="text-muted">Describe your idea in a sentence or two. It will be split into tasks.</p>

        <textarea class="form-control" rows="3" @bind="idea" placeholder="e.g. Build a landing page for my app"></textarea>

        <label class="form-label mt-3" for="schedule-type">Project type</label>
        <div id="schedule-type" class="schedule-type-toggle" role="radiogroup" aria-label="Project type">
            <button type="button" class="schedule-type-btn @(scheduleType == TaskScheduleType.DayWeek ? "active" : "")"
                    aria-pressed="@(scheduleType == TaskScheduleType.DayWeek)"
                    @onclick='() => scheduleType = TaskScheduleType.DayWeek'>
                <i class="bi bi-calendar3" aria-hidden="true"></i> Day project
            </button>
            <button type="button" class="schedule-type-btn @(scheduleType == TaskScheduleType.ProjectDeadline ? "active" : "")"
                    aria-pressed="@(scheduleType == TaskScheduleType.ProjectDeadline)"
                    @onclick='() => scheduleType = TaskScheduleType.ProjectDeadline'>
                <i class="bi bi-flag" aria-hidden="true"></i> Project with a deadline
            </button>
        </div>

        <label class="form-label mt-3" for="schedule-date">@(scheduleType == TaskScheduleType.ProjectDeadline ? "Deadline" : "Date")</label>
        <input id="schedule-date" type="date" class="form-control" @bind="scheduleDate" />

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }

        <button class="btn btn-primary action-button mt-3" disabled="@(isLoading || string.IsNullOrWhiteSpace(idea))" @onclick="Generate">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Creating checklist...</span>
            }
            else
            {
                <span>Break it down</span>
            }
        </button>
    }
</div>

@code {
    private string idea = "";
    private TaskScheduleType scheduleType = TaskScheduleType.DayWeek;
    private DateTime? scheduleDate;
    private bool isLoading;
    private bool projectCreated;
    private int createdTaskCount;
    private string? error;

    private async Task Generate()
    {
        isLoading = true;
        error = null;
        try
        {
            var breakdownTask = Gemini.BreakDownIdeaAsync(idea);
            var titleTask = GenerateTitleSafeAsync(idea);
            await Task.WhenAll(breakdownTask, titleTask);

            var taskTitles = breakdownTask.Result.Tasks;

            var project = new Project
            {
                Title = titleTask.Result + ScheduleSuffix(),
                OriginalIdea = idea,
                ScheduleType = scheduleType,
                ScheduleDate = scheduleDate,
                Tasks = taskTitles.Select((title, index) => new TaskItem { Title = title, SortOrder = index }).ToList()
            };
            await ProjectStore.SaveProjectAsync(project);
            createdTaskCount = taskTitles.Count;
            projectCreated = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }

    private async Task<string> GenerateTitleSafeAsync(string ideaText)
    {
        try
        {
            return await Gemini.GenerateTitleAsync(ideaText);
        }
        catch (Exception)
        {
            return ideaText.Length > 60 ? ideaText[..60] + "..." : ideaText;
        }
    }

    private string ScheduleSuffix()
    {
        if (scheduleDate is null) return "";
        return scheduleType == TaskScheduleType.ProjectDeadline
            ? $" — Due {scheduleDate.Value:MMM d}"
            : $" — {scheduleDate.Value:MMM d}";
    }
}
