@page "/new"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GeminiService Gemini
@inject NavigationManager Nav

<div style="max-width:480px;margin:0 auto;padding:1rem;">
    <h4>New project</h4>
    <p class="text-muted">Describe your idea in a sentence or two. It'll be split into tasks.</p>

    <textarea class="form-control mb-2" rows="3" @bind="idea" placeholder="e.g. Build a landing page for my app"></textarea>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    <button class="btn btn-primary" disabled="@(isLoading || string.IsNullOrWhiteSpace(idea))" @onclick="Generate">
        @(isLoading ? "Breaking it down..." : "Break it down")
    </button>
</div>

@code {
    private string idea = "";
    private bool isLoading;
    private string? error;

    private async Task Generate()
    {
        isLoading = true;
        error = null;
        try
        {
            var taskTitles = await Gemini.BreakDownIdeaAsync(idea);

            using var db = DbFactory.CreateDbContext();
            var project = new Project
            {
                Title = idea.Length > 60 ? idea[..60] + "..." : idea,
                OriginalIdea = idea,
                Tasks = taskTitles.Select((t, i) => new TaskItem { Title = t, SortOrder = i }).ToList()
            };
            db.Projects.Add(project);
            await db.SaveChangesAsync();

            Nav.NavigateTo($"/project/{project.Id}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
