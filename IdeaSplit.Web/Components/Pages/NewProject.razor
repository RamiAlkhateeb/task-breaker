@page "/new"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@inject IProjectStore ProjectStore
@inject GeminiService Gemini
@inject WebSearchService WebSearch
@inject NavigationManager Nav

<div class="page-container">
    <h1>New project</h1>
    @if (projectCreated)
    {
        <div class="alert alert-success">Your project is ready with @createdTaskCount tasks. You can check it out on the home page.</div>
        <button class="btn btn-primary action-button" @onclick='() => Nav.NavigateTo("/")'>OK</button>
    }
    else
    {
        <label class="book-toggle">
            <input type="checkbox" @bind="isBook" />
            <span><i class="bi bi-book" aria-hidden="true"></i> This is a book I want to read</span>
        </label>
        <p class="text-muted">@(isBook ? "Enter a book title and author to build a chapter checklist." : "Describe your idea in a sentence or two. It will be split into tasks.")</p>

        @if (isBook)
        {
            <input class="form-control" @bind="idea" placeholder="e.g. Dune by Frank Herbert" />
        }
        else
        {
            <textarea class="form-control" rows="3" @bind="idea" placeholder="e.g. Build a landing page for my app"></textarea>
        }

        @if (!string.IsNullOrEmpty(error))
        {
            <div class="alert alert-danger mt-3">@error</div>
        }

        <button class="btn btn-primary action-button mt-3" disabled="@(isLoading || string.IsNullOrWhiteSpace(idea))" @onclick="Generate">
            @if (isLoading)
            {
                <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>Creating checklist...</span>
            }
            else
            {
                <span>@(isBook ? "Get chapters" : "Break it down")</span>
            }
        </button>
    }
</div>

@code {
    private string idea = "";
    private bool isBook;
    private bool isLoading;
    private bool projectCreated;
    private int createdTaskCount;
    private string? error;

    private async Task Generate()
    {
        isLoading = true;
        error = null;
        try
        {
            List<string> taskTitles;
            if (isBook)
            {
                taskTitles = await Gemini.GetBookChaptersAsync(idea);
                if (taskTitles.Count < 2)
                    taskTitles = await WebSearch.SearchBookTableOfContentsAsync(idea);
                if (taskTitles.Count < 2)
                    throw new InvalidOperationException("No reliable table of contents was found. Check the title and author, or configure a Bing Web Search API key in Settings.");
            }
            else
            {
                var result = await Gemini.BreakDownIdeaAsync(idea);
                taskTitles = result.Tasks;
            }

            var project = new Project
            {
                Title = isBook ? idea : idea.Length > 60 ? idea[..60] + "..." : idea,
                OriginalIdea = idea,
                IsBook = isBook,
                Tasks = taskTitles.Select((title, index) => new TaskItem { Title = title, SortOrder = index }).ToList()
            };
            await ProjectStore.SaveProjectAsync(project);
            createdTaskCount = taskTitles.Count;
            projectCreated = true;
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
