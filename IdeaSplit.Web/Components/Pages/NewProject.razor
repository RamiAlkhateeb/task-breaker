@page "/new"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@using Microsoft.EntityFrameworkCore
@inject IDbContextFactory<AppDbContext> DbFactory
@inject GeminiService Gemini
@inject NavigationManager Nav

<div class="page-container">
    <h1>New project</h1>
    <p class="text-muted">Describe your idea in a sentence or two. It will be split into tasks.</p>

    <textarea class="form-control mb-2" rows="3" @bind="idea" placeholder="e.g. Build a landing page for my app"></textarea>

    @if (!string.IsNullOrEmpty(error))
    {
        <div class="alert alert-danger">@error</div>
    }

    @if (!string.IsNullOrEmpty(usedModel))
    {
        <p class="form-hint">Created with @usedModel.</p>
    }

    <button class="btn btn-primary action-button" disabled="@(isLoading || string.IsNullOrWhiteSpace(idea))" @onclick="Generate">
        @(isLoading ? "Breaking it down..." : "Break it down")
    </button>
</div>

@code {
    private string idea = "";
    private bool isLoading;
    private string? error;
    private string? usedModel;

    private async Task Generate()
    {
        isLoading = true;
        error = null;
        try
        {
            var result = await Gemini.BreakDownIdeaAsync(idea);
            usedModel = result.Model;

            using var db = DbFactory.CreateDbContext();
            var project = new Project
            {
                Title = idea.Length > 60 ? idea[..60] + "..." : idea,
                OriginalIdea = idea,
                Tasks = result.Tasks.Select((t, i) => new TaskItem { Title = t, SortOrder = i }).ToList()
            };
            db.Projects.Add(project);
            await db.SaveChangesAsync();

            Nav.NavigateTo($"/project/{project.Id}?model={Uri.EscapeDataString(result.Model)}");
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isLoading = false;
        }
    }
}
