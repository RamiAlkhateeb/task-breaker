@page "/settings"
@using IdeaSplit.Shared.Services
@inject SettingsService SettingsService
@inject ToastService Toasts

<PageTitle>@T["settings"] · NxtTask</PageTitle>

@* The family settings shell (appearance, AI, install, about) with NxtTask's dictation setting first. *@
<NxtSettingsPage BackHref="/">
    <AppSections>
        <AccountSection />
        <NxtSettingsSection Icon="🎙️" Title="@T["dictation_title"]" Description="@T["dictation_desc"]">
            <NxtSegmented TValue="string" Label="@T["dictation_label"]" Value="@speechLanguage" ValueChanged="SaveSpeechLanguageAsync"
                          Options="@([("en-US", "English"), ("ar-SA", "العربية")])" />
        </NxtSettingsSection>
    </AppSections>
</NxtSettingsPage>

@code {
    private string speechLanguage = SettingsService.DefaultSpeechLanguage;

    protected override async Task OnInitializedAsync() => speechLanguage = await SettingsService.GetSpeechLanguageAsync();

    private async Task SaveSpeechLanguageAsync(string value)
    {
        speechLanguage = value;
        await SettingsService.SaveSpeechLanguageAsync(value);
        Toasts.Show(T["dictation_saved"]);
    }
}
