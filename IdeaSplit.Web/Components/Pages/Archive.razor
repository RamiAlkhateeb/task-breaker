@page "/archive"
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@inject IProjectStore ProjectStore
@inject NavigationManager Nav

<div class="page-container">
    <button class="btn btn-link icon-button back-button" title="Back" aria-label="Back" @onclick='() => Nav.NavigateTo("/")'><i class="bi bi-arrow-left"></i></button>
    <h1>Archive</h1>

    @if (projects is null)
    {
        <div class="loading-stack" aria-label="Loading archived projects" role="status">
            <div class="skeleton-card"></div>
            <div class="skeleton-card"></div>
            <span class="visually-hidden">Loading archived projects</span>
        </div>
    }
    else if (projects.Count == 0)
    {
        <div class="empty-state">
            <h2>No archived projects</h2>
            <p>Completed projects show up here automatically.</p>
        </div>
    }
    else
    {
        @foreach (var p in projects)
        {
            <div class="card project-card" @onclick="() => Toggle(p.Id)">
                <div class="card-body">
                    <h5 class="card-title">@p.Title</h5>
                    <p class="project-meta">
                        <DueChip Date="p.ScheduleDate" Type="p.ScheduleType" Muted="true" />
                        <span class="text-muted">@p.DoneCount/@p.TotalCount tasks</span>
                    </p>
                    <div class="progress task-progress">
                        <div class="progress-bar" style="width:@(p.ProgressPercent)%"></div>
                    </div>
                    @if (expanded.Contains(p.Id))
                    {
                        <ul class="archive-tasks">
                            @foreach (var t in p.Tasks.Where(x => x.ParentTaskId is null).OrderBy(x => x.SortOrder))
                            {
                                <li>
                                    <i class="bi @(t.IsDone ? "bi-check-circle-fill is-done" : "bi-circle")" aria-hidden="true"></i>
                                    <div class="task-main">
                                        <span class="task-title @(t.IsDone ? "task-complete" : "")" dir="auto">@t.Title</span>
                                        @if (!string.IsNullOrWhiteSpace(t.ProjectName))
                                        {
                                            <span class="task-project">@t.ProjectName</span>
                                        }
                                        @foreach (var sub in p.Tasks.Where(x => x.ParentTaskId == t.Id).OrderBy(x => x.SortOrder))
                                        {
                                            <span class="archive-subtask @(sub.IsDone ? "task-complete" : "")" dir="auto"><i class="bi @(sub.IsDone ? "bi-check-circle-fill is-done" : "bi-circle")" aria-hidden="true"></i> @sub.Title</span>
                                        }
                                    </div>
                                </li>
                            }
                            @if (p.TotalCount == 0)
                            {
                                <li class="text-muted">No tasks.</li>
                            }
                        </ul>
                    }
                    <div class="project-card-footer">
                        <div class="project-card-actions">
                            <button class="btn btn-link icon-button card-action" title="@(expanded.Contains(p.Id) ? "Hide tasks" : "View tasks")" aria-label="@(expanded.Contains(p.Id) ? "Hide tasks" : "View tasks")" @onclick="() => Toggle(p.Id)" @onclick:stopPropagation="true"><i class="bi @(expanded.Contains(p.Id) ? "bi-chevron-up" : "bi-chevron-down")"></i></button>
                            <button class="btn btn-link icon-button card-action" title="Unarchive project" aria-label="Unarchive project" @onclick="() => Unarchive(p.Id)" @onclick:stopPropagation="true"><i class="bi bi-box-arrow-up"></i></button>
                        </div>
                    </div>
                </div>
            </div>
        }
    }
</div>

@code {
    private List<Project>? projects;
    private readonly HashSet<int> expanded = [];

    private void Toggle(int projectId)
    {
        if (!expanded.Remove(projectId)) expanded.Add(projectId);
    }

    protected override async Task OnInitializedAsync() => await LoadProjects();

    private async Task LoadProjects() =>
        projects = (await ProjectStore.GetProjectsAsync())
            .Where(project => project.IsArchived)
            .OrderByDescending(project => project.CreatedAt)
            .ToList();

    private async Task Unarchive(int projectId)
    {
        await ProjectStore.SetArchivedAsync(projectId, false);
        await LoadProjects();
    }
}
