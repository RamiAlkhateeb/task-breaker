@using IdeaSplit.Shared.Sync
@implements IDisposable
@inject SupabaseAuth Auth
@inject SupabaseSync Sync
@inject IJSRuntime JS
@inject ToastService Toasts

@if (Auth.IsConfigured)
{
    <NxtSettingsSection Icon="cloud" Title="@T["account_title"]" Description="@T["account_desc"]">
        @if (Auth.Session is { } session)
        {
            <div class="account-signed-in">
                <span class="nxt-label">@T["signed_in_label"]</span>
                <span class="account-email" dir="ltr">@session.Email</span>
            </div>
            <p class="account-status @(Sync.LastError is null ? "" : "account-status-error")" role="status">
                @if (Sync.IsSyncing) { <NxtSpinner Small="true" /> @T["syncing"] }
                else if (Sync.LastError is { } error) { @error }
                else if (Sync.LastSyncedAt is { } at) { @T.F("last_synced", at.ToLocalTime().ToString("t")) }
                else { @T["not_synced_yet"] }
            </p>
            <div class="account-actions">
                <NxtButton Variant="secondary" OnClick="Sync.SyncNowAsync" Busy="Sync.IsSyncing">@T["sync_now"]</NxtButton>
                <NxtButton Variant="ghost" OnClick="SignOutAsync">@T["sign_out"]</NxtButton>
            </div>
        }
        else
        {
            <label class="nxt-label" for="account-email">@T["email_label"]</label>
            <NxtTextInput Id="account-email" Type="email" Value="@email" ValueChanged="v => email = v" Placeholder="name@example.com"
                          dir="ltr" autocomplete="email" inputmode="email" />
            <label class="nxt-label" for="account-password">@T["password_label"]</label>
            <NxtTextInput Id="account-password" Type="password" Value="@password" ValueChanged="v => password = v"
                          dir="ltr" autocomplete="current-password" @onkeydown="OnPasswordKeyDown" />
            <p class="account-hint">@T["password_hint"]</p>
            <div class="account-actions">
                <NxtButton Variant="primary" OnClick="SignInAsync" Busy="busy" Disabled="@(!CanSubmit)">@T["sign_in"]</NxtButton>
                <NxtButton Variant="secondary" OnClick="SignUpAsync" Disabled="@(busy || !CanSubmit)">@T["create_account"]</NxtButton>
            </div>
        }
    </NxtSettingsSection>
}

@code {
    private string email = "";
    private string password = "";
    private bool busy;

    protected override void OnInitialized()
    {
        Auth.Changed += Refresh;
        Sync.StatusChanged += Refresh;
    }

    private void Refresh() => InvokeAsync(StateHasChanged);

    private bool CanSubmit => LooksLikeEmail(email) && password.Length >= MinPasswordLength;

    private const int MinPasswordLength = 6;

    private static bool LooksLikeEmail(string value) => value.Trim() is var trimmed && trimmed.Contains('@') && trimmed.Contains('.') && !trimmed.Contains(' ');

    private async Task OnPasswordKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter" && CanSubmit && !busy) await SignInAsync();
    }

    private Task SignInAsync() => SubmitAsync(() => Auth.SignInAsync(email, password));

    private Task SignUpAsync() => SubmitAsync(() => Auth.SignUpAsync(email, password));

    private async Task SubmitAsync(Func<Task<string?>> attempt)
    {
        busy = true;
        try
        {
            var error = await attempt();
            if (error is not null) { Toasts.Show(Friendly(error), isError: true); return; }
            password = "";
            Toasts.Show(T.F("signed_in_as", Auth.Session!.Email));
        }
        finally { busy = false; }
    }

    /// <summary>Supabase answers in English; show the common cases in the app's language.</summary>
    private string Friendly(string error) => error switch
    {
        _ when error.Contains("Invalid login credentials", StringComparison.OrdinalIgnoreCase) => T["error_wrong_password"],
        _ when error.Contains("already registered", StringComparison.OrdinalIgnoreCase) => T["error_account_exists"],
        _ when error.Contains("Password should", StringComparison.OrdinalIgnoreCase) => T["error_weak_password"],
        _ => error
    };

    private async Task SignOutAsync()
    {
        if (!await JS.InvokeAsync<bool>("confirm", T["confirm_sign_out"])) return;
        // Push anything not uploaded yet, so signing out never loses edits.
        await Sync.SyncNowAsync();
        if (Sync.LastError is not null && !await JS.InvokeAsync<bool>("confirm", T["confirm_sign_out_unsynced"])) return;
        await Sync.SignOutAsync(clearLocalData: true);
        Toasts.Show(T["signed_out"]);
    }

    public void Dispose()
    {
        Auth.Changed -= Refresh;
        Sync.StatusChanged -= Refresh;
    }
}
