@using System.Globalization
@using System.Text
@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@implements IAsyncDisposable
@inject IProjectStore ProjectStore
@inject GeminiService Gemini
@inject SettingsService Settings
@inject IJSRuntime JS

@if (chatOpen)
{
    <section class="chat-panel" aria-label="Planning assistant">
        <header class="chat-header">
            <span class="chat-title"><i class="bi bi-stars" aria-hidden="true"></i> Assistant</span>
            <button type="button" class="chat-icon-btn" title="New chat" aria-label="New chat" disabled="@isThinking" @onclick="NewChat"><i class="bi bi-arrow-counterclockwise"></i></button>
            <button type="button" class="chat-icon-btn" title="Hide chat" aria-label="Hide chat" @onclick="() => chatOpen = false"><i class="bi bi-chevron-down"></i></button>
        </header>

        <div class="chat-messages" aria-live="polite">
            @if (isThinking)
            {
                <div class="chat-row">
                    <div class="chat-bubble is-typing" aria-label="Assistant is typing"><span></span><span></span><span></span></div>
                </div>
            }

            @foreach (var message in Enumerable.Reverse(messages))
            {
                <div class="chat-row @(message.FromUser ? "is-user" : "")" @key="message">
                    @if (message.IsNote)
                    {
                        <div class="chat-note"><i class="bi bi-check2-circle" aria-hidden="true"></i> @message.Text</div>
                    }
                    else
                    {
                        <div class="chat-bubble @(message.FromUser ? "is-user" : "") @(message.IsError ? "is-error" : "")" dir="auto">@message.Text</div>
                    }

                    @if (message.Proposal.Count > 0)
                    {
                        <div class="proposal-card">
                            @foreach (var day in message.Proposal.GroupBy(item => item.Task.Date.Date).OrderBy(group => group.Key))
                            {
                                <div class="proposal-day">@DayLabel(day.Key)</div>
                                @foreach (var item in day)
                                {
                                    <label class="task-row proposal-item">
                                        <input type="checkbox" checked="@item.Selected" disabled="@message.Added"
                                               @onchange="() => item.Selected = !item.Selected" />
                                        <span class="task-main">
                                            <span class="task-title" dir="auto">@item.Task.Title</span>
                                            @if (!string.IsNullOrWhiteSpace(item.Task.ProjectName))
                                            {
                                                <span class="task-project">@item.Task.ProjectName</span>
                                            }
                                        </span>
                                    </label>
                                }
                            }

                            @if (message.Added)
                            {
                                <div class="proposal-added"><i class="bi bi-check2-circle" aria-hidden="true"></i> Added to your plan</div>
                            }
                            else
                            {
                                var selected = message.Proposal.Count(item => item.Selected);
                                <button type="button" class="btn btn-primary proposal-add" disabled="@(adding || selected == 0)" @onclick="() => AddProposal(message)">
                                    @(selected == 1 ? "Add 1 task to plan" : $"Add {selected} tasks to plan")
                                </button>
                            }
                        </div>
                    }
                </div>
            }

            @if (messages.Count == 0 && !isThinking)
            {
                <p class="chat-empty">Tell me what you have going on this week. I'll ask a question or two, then suggest tasks you can add.</p>
            }
        </div>
    </section>
}

@if (!string.IsNullOrEmpty(status))
{
    <div class="composer-status" role="status">@status</div>
}

<div class="composer">
    @if (!chatOpen && messages.Count > 0)
    {
        <button type="button" class="composer-icon-btn" title="Show chat" aria-label="Show chat" @onclick="() => chatOpen = true">
            <i class="bi bi-chat-dots"></i>
        </button>
    }
    <textarea class="composer-input" dir="auto" rows="@Rows" @bind="text" @bind:event="oninput"
              placeholder="@(listening ? "Listening..." : "What's on your plate?")"
              aria-label="Message the planning assistant"></textarea>
    @if (speechSupported)
    {
        <button type="button" class="composer-icon-btn @(listening ? "is-listening" : "")" title="@(listening ? "Stop recording" : "Dictate")"
                aria-label="@(listening ? "Stop recording" : "Dictate")" @onclick="ToggleMic">
            <i class="bi @(listening ? "bi-stop-fill" : "bi-mic")"></i>
        </button>
    }
    <button type="button" class="composer-send-btn" title="Send" aria-label="Send"
            disabled="@(string.IsNullOrWhiteSpace(text) || isThinking)" @onclick="Send">
        <i class="bi bi-arrow-up"></i>
    </button>
</div>

@code {
    private const int PlanContextDays = 30;

    [Parameter] public EventCallback OnCreated { get; set; }

    private sealed class ChatMessage
    {
        public bool FromUser { get; init; }
        public string Text { get; init; } = "";
        public string Raw { get; init; } = "";
        public bool IsError { get; init; }
        public bool IsNote { get; init; }
        public List<ProposalItem> Proposal { get; init; } = [];
        public bool Added { get; set; }
    }

    private sealed class ProposalItem
    {
        public required ProposedTask Task { get; init; }
        public bool Selected { get; set; } = true;
    }

    private readonly List<ChatMessage> messages = [];
    private DotNetObjectReference<PlanComposer>? selfRef;
    private string text = "";
    private string baseText = "";
    private string? status;
    private bool speechSupported;
    private bool listening;
    private bool chatOpen;
    private bool isThinking;
    private bool adding;

    private int Rows => Math.Clamp(text.Split('\n').Length, 1, 5);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        selfRef = DotNetObjectReference.Create(this);
        speechSupported = await JS.InvokeAsync<bool>("ideaSplitSpeech.isSupported");
        if (speechSupported) StateHasChanged();
    }

    private async Task Send()
    {
        var message = text.Trim();
        if (message.Length == 0 || isThinking) return;
        if (listening) await JS.InvokeVoidAsync("ideaSplitSpeech.stop");

        status = null;
        chatOpen = true;
        var userMessage = new ChatMessage { FromUser = true, Text = message };
        messages.Add(userMessage);
        text = "";
        isThinking = true;

        try
        {
            var history = messages
                .Where(m => !m.IsNote && !m.IsError)
                .Select(m => new ChatTurn(m.FromUser, m.FromUser ? m.Text : m.Raw))
                .ToList();
            var reply = await Gemini.ChatAsync(history, await BuildPlanContextAsync());
            messages.Add(new ChatMessage
            {
                Text = string.IsNullOrWhiteSpace(reply.Reply) ? "Here's what I'd suggest:" : reply.Reply,
                Raw = reply.RawJson,
                Proposal = reply.Tasks.Select(task => new ProposalItem { Task = task }).ToList()
            });
        }
        catch (Exception ex)
        {
            messages.Remove(userMessage);
            if (string.IsNullOrWhiteSpace(text)) text = message;
            messages.Add(new ChatMessage { IsError = true, Text = ex.Message });
        }
        finally
        {
            isThinking = false;
        }
    }

    private void NewChat()
    {
        messages.Clear();
        status = null;
    }

    private async Task AddProposal(ChatMessage message)
    {
        var chosen = message.Proposal.Where(item => item.Selected).Select(item => item.Task).ToList();
        if (chosen.Count == 0 || adding) return;

        adding = true;
        try
        {
            foreach (var day in chosen.GroupBy(task => task.Date.Date).OrderBy(group => group.Key))
                await AddTasksToDayAsync(day.Key, day.ToList());

            message.Added = true;
            var dayCount = chosen.Select(task => task.Date.Date).Distinct().Count();
            messages.Add(new ChatMessage
            {
                IsNote = true,
                Text = $"Added {chosen.Count} {(chosen.Count == 1 ? "task" : "tasks")} to {dayCount} {(dayCount == 1 ? "day" : "days")}."
            });
            await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            messages.Add(new ChatMessage { IsError = true, Text = ex.Message });
        }
        finally
        {
            adding = false;
        }
    }

    private async Task AddTasksToDayAsync(DateTime date, List<ProposedTask> tasks)
    {
        var day = await ProjectStore.GetOrCreateDayProjectAsync(date);
        var next = day.Tasks.Count(task => task.ParentTaskId is null);
        foreach (var task in tasks)
            day.Tasks.Add(new TaskItem { Title = task.Title, ProjectName = task.ProjectName, SortOrder = next++ });
        day.IsArchived = false;
        await ProjectStore.SaveProjectAsync(day);
    }

    private async Task<string> BuildPlanContextAsync()
    {
        var today = DateTime.Today;
        var days = (await ProjectStore.GetProjectsAsync())
            .Where(project => project.ScheduleType == TaskScheduleType.DayWeek && project.ScheduleDate is not null)
            .ToList();

        var plan = new StringBuilder();
        for (var offset = 0; offset <= PlanContextDays; offset++)
        {
            var date = today.AddDays(offset);
            var open = days
                .Where(project => project.ScheduleDate!.Value.Date == date)
                .SelectMany(project => project.Tasks)
                .Where(task => task.ParentTaskId is null && !task.IsDone)
                .Select(task => string.IsNullOrWhiteSpace(task.ProjectName) ? task.Title : $"{task.Title} [{task.ProjectName}]")
                .ToList();

            if (open.Count == 0 && offset > 6) continue;
            plan.Append(date.ToString("ddd yyyy-MM-dd", CultureInfo.InvariantCulture)).Append(": ")
                .AppendLine(open.Count == 0 ? "nothing planned" : string.Join("; ", open));
        }
        return plan.ToString();
    }

    private static string DayLabel(DateTime date) => (date - DateTime.Today).Days switch
    {
        0 => "Today",
        1 => "Tomorrow",
        _ => date.ToString("dddd, MMM d")
    };

    private async Task ToggleMic()
    {
        status = null;
        if (listening)
        {
            await JS.InvokeVoidAsync("ideaSplitSpeech.stop");
            return;
        }

        baseText = text;
        var language = await Settings.GetSpeechLanguageAsync();
        listening = await JS.InvokeAsync<bool>("ideaSplitSpeech.start", selfRef, language);
        if (!listening) status = "Could not start the microphone.";
    }

    [JSInvokable]
    public Task OnSpeechResult(string transcript)
    {
        text = string.IsNullOrWhiteSpace(baseText) ? transcript.Trim() : $"{baseText.TrimEnd()} {transcript.Trim()}";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpeechError(string reason)
    {
        if (reason is "not-allowed" or "service-not-allowed")
            status = "Microphone permission was denied.";
        else if (reason is not ("no-speech" or "aborted"))
            status = $"Dictation error: {reason}.";
        return InvokeAsync(StateHasChanged);
    }

    [JSInvokable]
    public Task OnSpeechEnded()
    {
        listening = false;
        return InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("ideaSplitSpeech.stop"); }
        catch (Exception) { /* page is going away */ }
        selfRef?.Dispose();
    }
}
