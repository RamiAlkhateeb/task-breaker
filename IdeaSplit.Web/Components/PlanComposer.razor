@using IdeaSplit.Shared.Data
@using IdeaSplit.Shared.Models
@using IdeaSplit.Shared.Services
@inject IProjectStore ProjectStore
@inject GeminiService Gemini
@inject SettingsService Settings

@if (!string.IsNullOrEmpty(status))
{
    <div class="composer-status" role="status">@status</div>
}

<NxtComposer @bind-Value="text" OnSubmit="_ => Submit()" CssClass="composer"
             Placeholder="@T["plan_placeholder"]" SendLabel="@T["submit"]" SpeechLanguage="@speechLanguage" />

@if (showSheet)
{
    <div class="composer-backdrop" @onclick="CloseSheet">
        <div class="composer-sheet" role="dialog" aria-label="@T["when_title"]" @onclick:stopPropagation="true">
            <h2>@T["when_title"]</h2>

            <div class="schedule-type-toggle entry-kind-toggle" role="radiogroup" aria-label="@T["entry_kind"]">
                <button type="button" class="schedule-type-btn @(isTask ? "active" : "")" aria-pressed="@isTask" @onclick="() => SetKind(true)">
                    <i class="bi bi-check2-square" aria-hidden="true"></i> @T["kind_task"]
                </button>
                <button type="button" class="schedule-type-btn @(!isTask ? "active" : "")" aria-pressed="@(!isTask)" @onclick="() => SetKind(false)">
                    <i class="bi bi-diagram-3" aria-hidden="true"></i> @T["kind_project"]
                </button>
            </div>

            @if (isTask)
            {
                <p class="form-hint">@T["task_hint"]</p>
            }
            else
            {
            <div class="schedule-type-toggle" role="radiogroup" aria-label="@T["plan_length"]">
                <button type="button" class="schedule-type-btn @(planType == TaskScheduleType.DayWeek ? "active" : "")"
                        aria-pressed="@(planType == TaskScheduleType.DayWeek)" @onclick="() => SetPlanType(TaskScheduleType.DayWeek)">
                    <i class="bi bi-calendar3" aria-hidden="true"></i> @T["one_day"]
                </button>
                <button type="button" class="schedule-type-btn @(planType == TaskScheduleType.ProjectDeadline ? "active" : "")"
                        aria-pressed="@(planType == TaskScheduleType.ProjectDeadline)" @onclick="() => SetPlanType(TaskScheduleType.ProjectDeadline)">
                    <i class="bi bi-flag" aria-hidden="true"></i> @T["multiple_days"]
                </button>
            </div>
            }

            <label class="form-label mt-3" for="plan-date">@(planType == TaskScheduleType.ProjectDeadline ? T["deadline"] : T["date"])</label>
            <div class="quick-dates">
                @if (planType == TaskScheduleType.DayWeek)
                {
                    <button type="button" class="quick-date-chip @(IsQuick(0) ? "active" : "")" @onclick="() => planDate = DateTime.Today">@T["today"]</button>
                    <button type="button" class="quick-date-chip @(IsQuick(1) ? "active" : "")" @onclick="() => planDate = DateTime.Today.AddDays(1)">@T["tomorrow"]</button>
                }
                else
                {
                    <button type="button" class="quick-date-chip @(IsQuick(3) ? "active" : "")" @onclick="() => planDate = DateTime.Today.AddDays(3)">@T["in_3_days"]</button>
                    <button type="button" class="quick-date-chip @(IsQuick(7) ? "active" : "")" @onclick="() => planDate = DateTime.Today.AddDays(7)">@T["in_a_week"]</button>
                    <button type="button" class="quick-date-chip @(IsQuick(14) ? "active" : "")" @onclick="() => planDate = DateTime.Today.AddDays(14)">@T["in_2_weeks"]</button>
                }
            </div>
            <input id="plan-date" type="date" class="form-control" @bind="planDate"
                   min="@MinDate.ToString("yyyy-MM-dd")" max="@MaxDateAttribute" />

            @if (planType == TaskScheduleType.ProjectDeadline)
            {
                <p class="form-hint">@T.F("deadline_hint", MaxDeadlineDays)</p>
            }

            @if (!string.IsNullOrEmpty(error))
            {
                <div class="alert alert-danger mt-3">@error</div>
            }

            <div class="composer-sheet-actions">
                <button type="button" class="btn btn-outline-secondary" disabled="@isWorking" @onclick="CloseSheet">@T["cancel"]</button>
                <button type="button" class="btn btn-primary" disabled="@isWorking" @onclick="Create">
                    @if (isWorking)
                    {
                        <span class="spinner-border spinner-border-sm" aria-hidden="true"></span><span>@T["planning"]</span>
                    }
                    else
                    {
                        <span>@(isTask ? T["add"] : T["create"])</span>
                    }
                </button>
            </div>
        </div>
    </div>
}

@code {
    private const int MaxDeadlineDays = 30;

    [Parameter] public EventCallback OnCreated { get; set; }

    private string text = "";
    private string? status;
    private string? error;
    private string speechLanguage = SettingsService.DefaultSpeechLanguage;
    private bool showSheet;
    private bool isTask;
    private bool isWorking;
    private TaskScheduleType planType = TaskScheduleType.DayWeek;
    private DateTime? planDate = DateTime.Today;

    private DateTime MinDate => planType == TaskScheduleType.ProjectDeadline ? DateTime.Today.AddDays(1) : DateTime.Today;
    private string? MaxDateAttribute => planType == TaskScheduleType.ProjectDeadline
        ? DateTime.Today.AddDays(MaxDeadlineDays).ToString("yyyy-MM-dd")
        : null;

    private bool IsQuick(int days) => planDate?.Date == DateTime.Today.AddDays(days);

    protected override async Task OnInitializedAsync() => speechLanguage = await Settings.GetSpeechLanguageAsync();

    private void Submit()
    {
        if (string.IsNullOrWhiteSpace(text)) return;
        status = null;
        error = null;
        planType = TaskScheduleType.DayWeek;
        planDate = DateTime.Today;
        isTask = LooksLikeTask(text);
        showSheet = true;
    }

    private void CloseSheet()
    {
        if (!isWorking) showSheet = false;
    }

    /// <summary>A single short line ("throw the trash") is almost always one to-do, not a project to break down.</summary>
    private static bool LooksLikeTask(string value)
    {
        var trimmed = value.Trim();
        return !trimmed.Contains('\n') && trimmed.Split((char[]?)null, StringSplitOptions.RemoveEmptyEntries).Length <= 5;
    }

    private void SetKind(bool task)
    {
        isTask = task;
        if (task) SetPlanType(TaskScheduleType.DayWeek);
        error = null;
    }

    private void SetPlanType(TaskScheduleType type)
    {
        planType = type;
        planDate = type == TaskScheduleType.ProjectDeadline ? DateTime.Today.AddDays(7) : DateTime.Today;
        error = null;
    }

    private string? Validate()
    {
        if (planDate is null) return T["pick_date"];
        var date = planDate.Value.Date;
        if (planType == TaskScheduleType.DayWeek)
            return date < DateTime.Today ? T["pick_future"] : null;

        var days = (date - DateTime.Today).Days;
        return days is >= 1 and <= MaxDeadlineDays ? null : T.F("pick_deadline", MaxDeadlineDays);
    }

    private async Task Create()
    {
        error = Validate();
        if (error is not null) return;

        isWorking = true;
        var idea = text.Trim();
        try
        {
            var touched = 0;

            if (isTask)
            {
                // Added as typed, one task per line; no Gemini call (works without an API key).
                var titles = idea.Split('\n').Select(line => line.Trim()).Where(line => line.Length > 0).ToList();
                var date = planDate!.Value.Date;
                await AddTasksToDayAsync(date, titles, null);

                showSheet = false;
                text = "";
                status = T.F("added_tasks_to_day", T.Tasks(titles.Count), T.DayLabel(date));
                await OnCreated.InvokeAsync();
                return;
            }

            if (planType == TaskScheduleType.DayWeek)
            {
                var breakdown = await Gemini.BreakDownIdeaAsync(idea);
                await AddTasksToDayAsync(planDate!.Value.Date, breakdown.Tasks, null);
                touched = 1;
            }
            else
            {
                var start = DateTime.Today;
                var dayCount = (planDate!.Value.Date - start).Days + 1;
                var titleTask = GenerateTitleSafeAsync(idea);
                var planTask = Gemini.PlanDaysAsync(idea, dayCount);
                await Task.WhenAll(planTask, titleTask);

                var plan = planTask.Result;
                for (var index = 0; index < Math.Min(dayCount, plan.Count); index++)
                {
                    if (plan[index].Count == 0) continue;
                    await AddTasksToDayAsync(start.AddDays(index), plan[index], titleTask.Result);
                    touched++;
                }
            }

            showSheet = false;
            text = "";
            status = T.F("added_to_days", T.Days(touched));
            await OnCreated.InvokeAsync();
        }
        catch (Exception ex)
        {
            error = ex.Message;
        }
        finally
        {
            isWorking = false;
        }
    }

    private async Task AddTasksToDayAsync(DateTime date, List<string> tasks, string? projectName)
    {
        var day = await ProjectStore.GetOrCreateDayProjectAsync(date);
        var next = day.Tasks.Count(task => task.ParentTaskId is null);
        foreach (var title in tasks)
        {
            day.Tasks.Add(new TaskItem { Title = title, ProjectName = projectName, SortOrder = next++ });
        }
        day.IsArchived = false;
        await ProjectStore.SaveProjectAsync(day);
    }

    private async Task<string> GenerateTitleSafeAsync(string idea)
    {
        try
        {
            return await Gemini.GenerateTitleAsync(idea);
        }
        catch (Exception)
        {
            return idea.Length > 40 ? idea[..40] + "..." : idea;
        }
    }
}
